{
    "name": "bakeoff/php-symfony",
    "type": "project",
    "require": {
        "php": "^8.4",
        "symfony/framework-bundle": "^8.0",
        "symfony/runtime": "^8.0",
        "symfony/string": "^8.0",
        "symfony/yaml": "^8.0"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
